{
	"name": "crow",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "npm run dev --workspace=apps/web",
		"host": "npm run dev --workspace=apps/web -- --host",
		"build": "npm run build --workspace=apps/web",
		"preview": "npm run preview --workspace=apps/web",
		"lint": "npm run lint --workspace=apps/web",
		"lint:fix": "npm run lint:fix --workspace=apps/web",
		"typecheck": "npm run typecheck --workspace=apps/web",
		"analyze": "npm run analyze --workspace=apps/web",
		"unused": "npm run unused --workspace=apps/web",
		"format": "npm run format --workspace=apps/web",
		"check": "npm run check --workspace=apps/web",
		"db:diff": "supabase db diff -f",
		"db:sync": "supabase db reset",
		"db:migrate": "supabase db push",
		"db:reset": "supabase db reset",
		"db:types": "supabase gen types typescript --linked > apps/web/src/shared/lib/supabase.types.ts",
		"db:verify": "supabase db diff --from migrations --to local",
		"db:backup": "supabase db dump --linked > supabase/schemas/live_backup_$(date +%F_%H%M%S).sql",
		"db:new": "supabase migration new"
	},
	"devDependencies": {
		"supabase": "2.122.1"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.105.0"
	}
}
